{
  "name": "node-api-template",
  "version": "1.0.0",
  "description": "Production-ready Node.js + TypeScript + Express + MySQL REST API template",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "dev:worker": "tsx watch --clear-screen=false src/worker.ts",
    "build": "rimraf dist && tsc -p tsconfig.json",
    "start": "node --require ./dist/instrumentation.js dist/server.js",
    "start:prod": "NODE_ENV=production node --require ./dist/instrumentation.js dist/server.js",
    "worker": "node --require ./dist/instrumentation.js dist/worker.js",
    "typecheck": "tsc -p tsconfig.eslint.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "db:create": "tsx src/db/cli.ts db:create",
    "db:drop": "tsx src/db/cli.ts db:drop",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:migrate:undo": "tsx src/db/cli.ts migrate:undo",
    "db:migrate:undo:all": "tsx src/db/cli.ts migrate:undo:all",
    "db:migrate:status": "tsx src/db/cli.ts migrate:status",
    "db:seed": "tsx src/db/cli.ts seed",
    "db:seed:undo": "tsx src/db/cli.ts seed:undo:all",
    "db:reset": "tsx src/db/cli.ts db:drop && tsx src/db/cli.ts db:create && tsx src/db/cli.ts migrate && tsx src/db/cli.ts seed",
    "db:migrate:prod": "NODE_ENV=production node dist/db/cli.js migrate",
    "migration:create": "node scripts/create-migration.mjs",
    "audit": "npm audit --audit-level=high",
    "docs:export": "tsx scripts/export-openapi.ts",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@aws-sdk/client-s3": "^3.1149.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation-express": "^0.71.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-ioredis": "^0.71.0",
    "@opentelemetry/instrumentation-mysql2": "^0.69.0",
    "@opentelemetry/instrumentation-pino": "^0.69.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.12",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.1.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.1",
    "sequelize": "^6.37.8",
    "swagger-ui-express": "^5.0.1",
    "umzug": "^3.8.3",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
