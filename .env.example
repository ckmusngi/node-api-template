# ---------------------------------------------------------------------------
# Copy to .env and adjust. Values here are safe local defaults, never secrets.
# Every variable is validated at startup (src/config/env.ts).
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_NAME=node-api-template
HOST=0.0.0.0
PORT=3000
APP_URL=http://localhost:3000
# Set to the number of proxies in front of the app (e.g. 1 behind an AWS ALB).
TRUST_PROXY=false
BODY_LIMIT=100kb
SHUTDOWN_TIMEOUT_MS=10000

LOG_LEVEL=debug
LOG_PRETTY=true

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=node_api_template
DB_USER=root
DB_PASSWORD=
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000
DB_LOGGING=false
DB_SSL=false

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_ISSUER=node-api-template
JWT_AUDIENCE=node-api-template-clients
REFRESH_TOKEN_TTL=7d
REFRESH_COOKIE_NAME=refresh_token
COOKIE_SECURE=false
BCRYPT_ROUNDS=12
EMAIL_VERIFICATION_TTL=24h
PASSWORD_RESET_TTL=1h
REQUIRE_EMAIL_VERIFICATION=false

# --- Rate limiting & login throttling ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MS=900000

# --- Seeding ---
SEED_ADMIN_EMAIL=admin@example.com
# Required when seeding production. Defaults to Password123! elsewhere.
SEED_ADMIN_PASSWORD=

# --- Optional: Redis (cache, distributed rate limiting, queues) ---
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
CACHE_TTL_SECONDS=60
# Background jobs with BullMQ (requires REDIS_ENABLED=true and `npm run worker`)
QUEUE_ENABLED=false

# --- Optional: Email ---
# json = log emails locally; smtp = send for real
MAIL_TRANSPORT=json
MAIL_FROM="No Reply <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- Optional: File uploads ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
UPLOAD_MAX_BYTES=5242880
UPLOAD_ALLOWED_MIME=image/png,image/jpeg,image/webp,application/pdf
AWS_REGION=us-east-1
S3_BUCKET=

# --- Optional: Webhooks ---
WEBHOOK_SECRET=
WEBHOOK_TOLERANCE_SECONDS=300

# --- Optional: Idempotency, multi-tenancy, WebSockets ---
IDEMPOTENCY_TTL=24h
MULTI_TENANCY_ENABLED=false
WS_ENABLED=false

# --- Optional: OpenTelemetry ---
OTEL_ENABLED=false
OTEL_SERVICE_NAME=node-api-template
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Optional: External API (Axios client example) ---
EXTERNAL_API_BASE_URL=https://httpbin.org
EXTERNAL_API_TIMEOUT_MS=5000

SWAGGER_ENABLED=true
