# Loaded automatically when NODE_ENV=test. Points at an isolated database that tests recreate.
APP_URL=http://localhost:3000
LOG_LEVEL=silent
LOG_PRETTY=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=node_api_template_test
DB_USER=root
DB_PASSWORD=
JWT_ACCESS_SECRET=test-secret-that-is-at-least-32-characters-long
BCRYPT_ROUNDS=4
RATE_LIMIT_MAX=10000
AUTH_RATE_LIMIT_MAX=10000
LOGIN_MAX_ATTEMPTS=3
CORS_ORIGINS=http://allowed.example
WEBHOOK_SECRET=test-webhook-secret
STORAGE_LOCAL_DIR=.test-uploads
MAIL_TRANSPORT=json
